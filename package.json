{
  "name": "frost-glass-css",
  "version": "1.0.0",
  "description": "A modern glassmorphism CSS library with dual theme support",
  "main": "src/themes/frost-glass.css",
  "files": [
    "src/",
    "dist/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run minify",
    "build:css": "cat src/core/variables.css src/core/base.css src/core/utilities.css src/components/*.css src/effects/*.css src/themes/frost-light.css src/themes/frost-dark.css > dist/frost-glass.css",
    "build:js": "rollup -c rollup.config.ts --configPlugin typescript",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "minify": "npx csso dist/frost-glass.css --output dist/frost-glass.min.css",
    "dev": "vite",
    "dev:storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "serve": "npm run dev",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:accessibility": "vitest run tests/accessibility",
    "lint": "npm run lint:css && npm run lint:js",
    "lint:css": "npx stylelint 'src/**/*.css'",
    "lint:js": "npx eslint 'src/**/*.{js,ts}' --fix",
    "format": "npx prettier --write 'src/**/*.{css,js,ts}'",
    "validate": "npm run lint && npm run test && npm run build",
    "clean": "rm -rf dist/*",
    "size-check": "node bundlesize.config.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frosty40/frost-glass-css.git"
  },
  "keywords": [
    "css",
    "glassmorphism",
    "frost-glass",
    "ui",
    "components",
    "themes",
    "light-theme",
    "dark-theme",
    "blur-effects",
    "backdrop-filter",
    "modern-css",
    "web-design",
    "frontend",
    "responsive",
    "accessibility"
  ],
  "author": "frosty40",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/frosty40/frost-glass-css/issues"
  },
  "homepage": "https://github.com/frosty40/frost-glass-css#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@storybook/addon-a11y": "^7.6.20",
    "@storybook/addon-essentials": "^7.6.20",
    "@storybook/html-vite": "^7.6.20",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^20.19.11",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "axe-core": "^4.10.3",
    "csso-cli": "^4.0.1",
    "eslint": "^9.34.0",
    "gzip-size": "^7.0.0",
    "happy-dom": "^18.0.1",
    "live-server": "^1.2.2",
    "prettier": "^3.0.0",
    "rollup": "^4.50.0",
    "storybook": "^7.6.20",
    "stylelint": "^15.0.0",
    "stylelint-config-standard": "^34.0.0",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "browserslist": [
    "Chrome >= 76",
    "Firefox >= 72",
    "Safari >= 13",
    "Edge >= 79",
    "iOS >= 13",
    "Android >= 76"
  ],
  "cdn": {
    "jsdelivr": "https://cdn.jsdelivr.net/npm/frost-glass-css@1.0.0/dist/frost-glass.min.css",
    "unpkg": "https://unpkg.com/frost-glass-css@1.0.0/dist/frost-glass.min.css"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/frosty40"
  }
}
