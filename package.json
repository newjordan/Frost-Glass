{
  "name": "frost-glass-css",
  "version": "1.1.0",
  "description": "Pure-CSS glassmorphism library with light and dark themes",
  "main": "./dist/frost-glass.css",
  "style": "./dist/frost-glass.css",
  "exports": {
    ".": "./dist/frost-glass.css",
    "./min": "./dist/frost-glass.min.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newjordan/Frost-Glass.git"
  },
  "keywords": [
    "css",
    "glassmorphism",
    "frost-glass",
    "ui",
    "components",
    "themes",
    "light-theme",
    "dark-theme",
    "blur-effects",
    "backdrop-filter",
    "modern-css",
    "web-design",
    "frontend",
    "responsive",
    "accessibility"
  ],
  "author": "Frosty40",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/newjordan/Frost-Glass/issues"
  },
  "homepage": "https://github.com/newjordan/Frost-Glass#readme",
  "devDependencies": {
    "lightningcss": "^1.30.2"
  },
  "engines": {
    "node": ">=18"
  }
}
